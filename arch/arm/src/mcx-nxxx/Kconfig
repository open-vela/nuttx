endmenu # LPSPI Peripherals

menuconfig N947_ENET
	bool "ENET (Ethernet) support"
	default n
	depends on NET && ARCH_CHIP_N947
	select NET_ETHERNET
	select ARCH_HAVE_PHY
	select ARCH_HAVE_NETDEV_STATISTICS
	select NETDEV_TELNET if TELNETD
	---help---
		Enable the DWC EMAC Ethernet driver for MCXN947.  The board layer
		provides the external PHY identity, address and status decoding.

if N947_ENET

config N947_ENET_NETHIFS
	int "Number of ENET interfaces"
	default 1

config N947_ENET_NTXBUFFERS
	int "Number of TX DMA buffers"
	default 6

config N947_ENET_NRXBUFFERS
	int "Number of RX DMA buffers"
	default 10

config N947_ENET_BUFSIZE
	int "Ethernet buffer size"
	default 1520

endif # N947_ENET

endmenu # NXXX Peripheral Selection

endif # ARCH_CHIP_MCX_NXXX
