if ARCH_CHIP_MCX_NXXX

menu "MCX NXXx Chip Selection"

config ARCH_CHIP_N947
	bool "MCXN947 Processor"
	default y
	select ARCH_HAVE_RESET
	select ARMV8M_HAVE_ICACHE
	select ARMV8M_NXP_BOOTROM_HEADER

endmenu # "MCX NXXx Chip Selection"

menu "NXXX Peripheral Selection"

config NXXX_GPIO_IRQ
	bool "GPIO Interrupt Support"
	default y

config N947_EDMA
	bool "eDMA support"
	default n
	select ARCH_DMA
	---help---
		Enable the MCX Nxxx eDMA driver.  This only provides the
		generic DMA channel allocator/programming layer; peripherals
		still need to opt in to using DMA.

config N947_EDMA_NTCD
	int
	default 1
	depends on N947_EDMA
	---help---
		Number of hardware TCD slots exposed by this initial driver.
		Scatter/gather TCD pooling is not enabled yet, so this remains
		at one descriptor.

config N947_EDMA_ELINK
	bool
	default n
	depends on N947_EDMA
	---help---
		Channel linking is not enabled in the initial MCX Nxxx eDMA
		driver.

config N947_EDMA_SELFTEST
	bool "Run eDMA self-test at board bring-up"
	default n
	depends on N947_EDMA
	---help---
		Run a short software-triggered memory-to-memory transfer on each
		MCX Nxxx eDMA controller from board late bring-up.  This is meant
		for BSP validation only and is disabled by default.

config N947_SAI
	bool
	default n
	select I2S

config N947_SAI_MAXINFLIGHT
	int "Maximum queued buffers per SAI direction"
	default 4
	range 2 16
	depends on N947_SAI
	---help---
		Number of small buffer descriptors preallocated for each SAI
		direction.  Audio payload memory is owned by the upper half and is
		not duplicated.  Four descriptors keeps the static SRAM cost low
		while allowing capture and playback to be pipelined.

config N947_SAI1
	bool "SAI1 full-duplex I2S support"
	default n
	depends on ARCH_CHIP_N947
	select N947_SAI
	---help---
		Enable the MCXN947 SAI1 lower-half driver.  SAI1 TX is the clock
		controller and RX is synchronous with TX, allowing an I2S speaker
		and digital microphone to share BCLK and frame sync.  The initial
		driver uses FIFO interrupts and standard NuttX I2S buffers.

config N947_SAI_TXDMA
	bool "SAI transmit eDMA support"
	default n
	depends on N947_SAI1 && N947_EDMA
	---help---
		Use the MCX Nxxx eDMA controller to feed the SAI transmit FIFO.
		16-bit application PCM is expanded in a small reusable staging
		buffer to the two 32-bit physical I2S slots used by SAI1.  This
		removes the high-rate transmit FIFO interrupt load while leaving
		receive operation and the standard NuttX I2S API unchanged.

config N947_LPADC
	bool "LPADC support"
	default n
	select ANALOG
	select ADC
	---help---
		Enable the MCX Nxxx LPADC lower-half driver.  The initial driver
		supports software-triggered one-shot conversions through the
		standard NuttX ADC upper-half.

menu "LPADC Peripherals"

menuconfig N947_LPADC0
	bool "LPADC0"
	default n
	select N947_LPADC

if N947_LPADC0

config N947_LPADC0_CHANNEL
	int "LPADC0 default board channel"
	default 0
	range 0 31
	---help---
		Default channel registered by the FRDM-MCXN947 board as /dev/adc0.
		Change this to match the analog input pin being tested.

endif # N947_LPADC0

menuconfig N947_LPADC1
	bool "LPADC1"
	default n
	select N947_LPADC

if N947_LPADC1

config N947_LPADC1_CHANNEL
	int "LPADC1 default board channel"
	default 0
	range 0 31
	---help---
		Default channel for boards that register LPADC1.

endif # N947_LPADC1

endmenu # LPADC Peripherals

config N947_CTIMER_PWM
	bool "CTIMER PWM support"
	default n
	select PWM
	---help---
		Enable the MCX Nxxx CTIMER PWM lower-half driver.  The driver
		uses one match register as the period/reset source and one match
		output as the PWM signal, then exposes the timer through the
		standard NuttX PWM upper-half.

menu "CTIMER PWM Peripherals"
	depends on N947_CTIMER_PWM

config N947_CTIMER_PWM_PERIOD_MATCH
	int "CTIMER period match channel"
	default 3
	range 0 3
	---help---
		Match channel used to define the PWM period.  The output match
		channel selected below must be different from this value.

menuconfig N947_CTIMER0_PWM
	bool "CTIMER0 PWM"
	default n

if N947_CTIMER0_PWM

config N947_CTIMER0_PWM_MATCH
	int "CTIMER0 PWM output match channel"
	default 0
	range 0 3

endif # N947_CTIMER0_PWM

menuconfig N947_CTIMER1_PWM
	bool "CTIMER1 PWM"
	default n

if N947_CTIMER1_PWM

config N947_CTIMER1_PWM_MATCH
	int "CTIMER1 PWM output match channel"
	default 0
	range 0 3

endif # N947_CTIMER1_PWM

menuconfig N947_CTIMER2_PWM
	bool "CTIMER2 PWM"
	default n

if N947_CTIMER2_PWM

config N947_CTIMER2_PWM_MATCH
	int "CTIMER2 PWM output match channel"
	default 0
	range 0 3

endif # N947_CTIMER2_PWM

menuconfig N947_CTIMER3_PWM
	bool "CTIMER3 PWM"
	default n

if N947_CTIMER3_PWM

config N947_CTIMER3_PWM_MATCH
	int "CTIMER3 PWM output match channel"
	default 0
	range 0 3

endif # N947_CTIMER3_PWM

menuconfig N947_CTIMER4_PWM
	bool "CTIMER4 PWM"
	default n

if N947_CTIMER4_PWM

config N947_CTIMER4_PWM_MATCH
	int "CTIMER4 PWM output match channel"
	default 0
	range 0 3

endif # N947_CTIMER4_PWM

endmenu # CTIMER PWM Peripherals

config NXXX_LPI2C
	bool "LPI2C support"
	default n

menu "LPUART"

config NXXX_LPUART
	bool
	default n
	select ARCH_HAVE_SERIAL_TERMIOS

config NXXX_LPUART1
	bool "LPUART1"
	default n
	select NXXX_LPUART
	select LPUART1_SERIALDRIVER

config NXXX_LPUART2
	bool "LPUART2"
	default n
	select NXXX_LPUART
	select LPUART2_SERIALDRIVER

config NXXX_LPUART3
	bool "LPUART3"
	default n
	select NXXX_LPUART
	select LPUART3_SERIALDRIVER

config NXXX_LPUART4
	bool "LPUART4"
	default n
	select NXXX_LPUART
	select LPUART4_SERIALDRIVER

config NXXX_LPUART5
	bool "LPUART5"
	default n
	select NXXX_LPUART
	select LPUART5_SERIALDRIVER

config NXXX_LPUART6
	bool "LPUART6"
	default n
	select NXXX_LPUART
	select LPUART6_SERIALDRIVER

config NXXX_LPUART7
	bool "LPUART7"
	default n
	select NXXX_LPUART
	select LPUART7_SERIALDRIVER

config NXXX_LPUART8
	bool "LPUART8"
	default n
	select NXXX_LPUART
	select LPUART8_SERIALDRIVER

config NXXX_LPUART9
	bool "LPUART9"
	default n
	select NXXX_LPUART
	select LPUART9_SERIALDRIVER

menu "LPUART Configuration"
	depends on NXXX_LPUART

config NXXX_LPUART_INVERT
	bool "Signal Invert Support"
	default n

config NXXX_LPUART_SINGLEWIRE
	bool "Signal Wire Support"
	default n

config NXXX_SERIAL_RXDMA_BUFFER_SIZE
	int "RX DMA buffer size"
	default 32
	depends on LPUART1_RXDMA || LPUART2_RXDMA || LPUART3_RXDMA || LPUART4_RXDMA || \
               LPUART5_RXDMA || LPUART6_RXDMA || LPUART7_RXDMA || LPUART8_RXDMA || \
               LPUART9_RXDMA

	---help---
		The DMA buffer size when using RX DMA to emulate a FIFO.

		When streaming data, the generic serial layer will be called
		every time the FIFO receives half this number of bytes.

		Value given here will be rounded up to next multiple of 32 bytes.

endmenu # LPUART Configuration

endmenu # LPUART

