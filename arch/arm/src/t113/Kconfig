config T113_DMA
	bool "DMA Controller"
	default n
	select ARCH_DMA
	---help---
		Enable T113 DMAC driver (16 channels).
		Required by T113_SPI_DMA.

config T113_UART_DMA
	bool "UART DMA (TX and RX on all enabled UARTs)"
	default n
	depends on T113_DMA
	select SERIAL_RXDMA
	select SERIAL_TXDMA
	---help---
		Route every enabled UART's RX and TX traffic through the
		DMAC instead of the CPU ISR path.  Enables both directions
		on every UARTn whose CONFIG_T113_UARTn=y.

		At high baud rates (>= 1 Mbaud) this dramatically reduces
		CPU load and eliminates the ERBFI IRQ storm that affects
		interrupt-mode RX on SMP.  At low baud (<= 115200) the
		overhead vs interrupt mode is negligible.

config T113_UART_DMA_BOUNCE_SIZE
	int "UART DMA bounce buffer size (bytes)"
	default 4096
	range 256 32767
	depends on T113_UART_DMA
	---help---
	  Size of the per-channel DMA bounce buffer used for UART TX and
	  RX DMA transfers.  Larger values reduce DMA completion interrupt
	  rate proportionally.

	  TX: one interrupt fires per bounce-sized chunk.  With 4096 bytes
	  the interrupt rate drops 16x vs the 256-byte default for typical
	  4 KiB writes.

	  RX: the DMA callback fires when the bounce buffer is full; partial
	  transfers are drained by the poll worker so short-packet latency is
	  unaffected.

	  Must not exceed CONFIG_UARTn_RXBUFSIZE (currently 32767) to avoid
	  data loss when the DMA callback tries to deliver more bytes than
	  the RX ring buffer can hold.

