if T113_SMHC

config T113_SMHC0
	bool "SMHC0 (microSD, PF0-PF5 Func2)"
	default n
	---help---
		Enable SMHC0 instance.  Shares pins with JTAG and UART0
		on PF0-PF5; when enabled, JTAG probe access is lost.

config T113_SMHC1
	bool "SMHC1 (SDIO WiFi, PG0-PG5 Func2)"
	default n
	---help---
		Enable SMHC1 instance.  Used by the RTL8723DS WiFi module
		on R528 HMI EVB4.

config T113_SMHC_DMA_DESC_COUNT
	int "Number of DMA descriptors per instance"
	default 128
	range 4 512
	---help---
		Size of the per-instance IDMAC descriptor ring.  Each
		descriptor transfers up to 8188 bytes (T113_SMHC_DES1_SIZE_MAX),
		so the ring length caps the maximum single-shot DMA transfer
		size at COUNT * 8188 bytes.  Default 128 -> ~1 MiB per CMD18 /
		CMD25, large enough that mmcsd does not slice typical >=256 KiB
		dd / fread requests.  Each descriptor is 16 bytes so the static
		array costs COUNT * 16 B per enabled SMHC instance.

config T113_SMHC_SELFTEST
	bool "SMHC0 self-test (CMD0/CMD8/ACMD41 enumeration on init)"
	default n
	depends on T113_SMHC0
	---help---
		Bring-up self-test that exercises the command/response path
		on SMHC0 right after t113_smhc_initialize() returns.  Issues
		CMD0 (GO_IDLE), CMD8 (SEND_IF_COND, expecting echo 0x1AA) and
		a 100-iteration CMD55+ACMD41 loop until OCR bit 31 (init done)
		is observed.  Diagnostic only -- enable when bringing up a
		new microSD slot to verify wiring before letting mmcsd_sdio
		take over.  Default n.

config T113_SMHC_SELFTEST_SDIO
	bool "SMHC0 SDIO self-test (CMD52/CMD53 protocol smoke)"
	default n
	depends on T113_SMHC_SELFTEST
	---help---
		Additional SDIO-side self-test that issues CMD52 reads against
		function 0 (CCCR) and an invalid function 7, plus a CMD53
		byte-mode 4-byte read.  No SDIO device is present on SMHC0 (it
		is wired to a microSD socket), so the test only proves that the
		protocol path returns control to the caller in finite time --
		i.e. the controller never hangs on a non-responsive bus.
		Diagnostic only.  Default n.

config T113_SMHC_SDCLK_HZ
	int "SD transfer SDCLK frequency in Hz (HS-SDR25 default 50 MHz)"
	default 50000000
	range 25000000 100000000
	---help---
		SDCLK frequency for SD CMD17/18/24/25 data-phase transfer.
		The default 50000000 (50 MHz) is the SD spec ceiling for
		HS-SDR25 at 3.3V signalling.

		Values above 50 MHz are OUT OF SPEC at 3.3V (SD Physical Layer
		caps SDR at 50 MHz on the 3.3V rail; the 100 MHz UHS-I SDR50
		mode requires 1.8V signalling, which the T113-EVB hardware
		does not support).  Some cards still tolerate 75/100 MHz
		cleanly; others may produce CRC errors or fail to respond.

		Used as both a production knob (50 MHz, in-spec) and as a
		diagnostic to bracket whether the throughput plateau is
		SDCLK-bound or host-side overhead-bound.

		Common values:
		  50000000  HS-SDR25 in-spec (production)
		  75000000  Overclock, mild risk
		  100000000 Overclock, ~2x throughput, card-dependent

endif # T113_SMHC

endmenu # Allwinner T113 Peripheral Support

config T113_DDR_MAPSIZE
	int "Installed DDR size (bytes)"
	default 134217728
	range 134217728 536870912
	---help---
		Physical DDR size installed on board.
		128 MB = 134217728
		256 MB = 268435456
		512 MB = 536870912

config T113_BOOT0
	bool "Build as boot0 (eGON header, SRAM linker script)"
	default n
	select LIBC_ATOMIC_IRQ
	---help---
		Build this binary as a boot0/SPL for BROM loading.
		Adds eGON header (t113_boot0.S) at binary start,
		uses sram.ld (all sections in 160KB SRAM at 0x20000),
		and runs mksunxi.py to patch the BROM checksum.

		Two sub-modes:
		- NOOS=y: bare-metal boot0 (t113_load.c: clock/DDR/NAND init)
		- NOOS=n: minimal NuttX boot0 (uses NuttX SPI/MTD drivers)

		Disable for standard NuttX AP binary (loaded to DDR by
		boot0 or xfel).

config T113_BOOT0_NOOS
	bool "Bare-metal boot0 (no NuttX scheduler)"
	default n
	depends on T113_BOOT0
	---help---
		Link the bare-metal boot0 implementation (t113_load.c)
		which handles clock init, DDR init, SPI NAND read, and
		jump to DDR without any NuttX infrastructure.
		Compiled with -O3 -fno-lto -fno-stack-protector.

		When disabled with T113_BOOT0=y, a minimal NuttX runs
		from SRAM and uses NuttX drivers for storage access.

config T113_FEL_RESCUE_THRESHOLD
	int "Abnormal reboot threshold to force FEL"
	default 0
	range 0 255
	---help---
		Detect crash-loops early in arm_boot() and drop the device
		into BROM FEL mode after this many consecutive abnormal
		reboots, so it can always be recovered with `xfel write`.

		An "abnormal" reboot is any reset path that does NOT carry
		the BOARDIOC_SOFTRESETCAUSE_USER_REBOOT marker AND happens
		AFTER the system has booted at least once: silent WDT,
		ASSERT, PANIC (incl. CONFIG_TTY_FORCE_PANIC), HardFault,
		and xfel reset without USER marker all count.  Cold POR
		(true power-on, VDD_RTC was lost) does NOT count — it is
		the first boot, not a crash.  Reboots more than 30 seconds
		apart are considered cooled-down and reset the counter.

		For host-driven workflows that want to enter boot0 cleanly
		via xfel reset (e.g. after `xfel spinand write`), pre-write
		the USER marker so boot0 short-circuits the count path:

		    xfel write32 0x07090100 0x5AA50000   # USER marker
		    xfel reset

		State persists across WDT in three RTC GP_DATA registers
		(VDD_RTC domain): GP_DATA[0] boot marker, GP_DATA[1] count
		+ magic, GP_DATA[2] last boot timestamp.

		Special values:
		    0  - Disable the feature entirely (Kconfig default).
		         Set this in production after firmware is stable.
		    1  - Force FEL on the very first crash after a
		         successful boot.  This is the recommended value
		         for development boards (set in the boot0-nuttx
		         defconfig): any crash → FEL → host can re-flash
		         via `xfel ddr && xfel write && xfel exec` without
		         needing JLink.  Combine with CONFIG_TTY_FORCE_PANIC
		         to force-FEL on demand from serial.  Cold POR is
		         exempt and boots normally.
		    N  - Force FEL after N abnormal reboots in <30 s
		         windows (5 is a reasonable production value if
		         the rescue is kept enabled at all).

		The chip-level RTC helpers it uses live in t113_rtc.c and
		access GP_DATA / YMD / HMS / LOSC_CTRL directly via the
		LOSC ACC handshake, so this option works with or without
		CONFIG_T113_RTC (the rtc_lowerhalf framework driver).

		Last-resort recovery: if the rescue path itself crashes
		(e.g. a hardware fault inside RTC MMIO) the device still
		recovers via the BROM FEL strap — hold the FEL button at
		POR and `xfel write` always works because BROM scans USB
		unconditionally on cold boot.

config T113_DE
	bool "T113 Display Engine (DE v2x)"
	default n
	---help---
		Enable T113 Display Engine driver. Required for any display
		output. Provides framebuffer interface via /dev/fb0.

config T113_TCON
	bool "T113 TCON-LCD0"
	default n
	depends on T113_DE
	---help---
		Enable T113 TCON-LCD0 timing controller. Pairs with the
		MIPI DSI host for DSI panels.

config T113_DSI
	bool "T113 MIPI DSI host"
	default n
	depends on T113_TCON
	select MIPI_DSI
	---help---
		Enable T113 MIPI DSI host controller driver. Implements the
		mipi_dsi_host interface from drivers/video/mipidsi/.

endif # ARCH_CHIP_T113
