if T113_USBHOST

config T113_EHCI
	bool "Enable USB1 EHCI (High Speed)"
	default y

config T113_EHCI_PREALLOCATE
	bool "Pre-allocate EHCI QH/QTD descriptor pools"
	default y
	depends on T113_EHCI
	---help---
		Allocate EHCI queue heads and qTDs statically at build time
		rather than lazily from the heap. Matches the SoC-specific
		convention used by SAMA5/IMXRT/LPC43 EHCI ports.

config T113_EHCI_NQHS
	int "Number of EHCI QH structures"
	depends on T113_EHCI
	default 4

config T113_EHCI_NQTDS
	int "Number of EHCI QTD structures"
	depends on T113_EHCI
	default 12
	help
		Preallocated qTD descriptors shared across all queued async
		transfers.  The EHCI driver chains multiple qTDs for any
		data-phase > 16 KiB (see T113_QTD_MAX_XFER in t113_ehci.c),
		so the required pool size is roughly:

		    ceil(max_bulk_xfer / 16 KiB) * concurrent_transfers
		        + 4  (SETUP + STATUS + slack)

		USB MSC forceformat issues ~34 KiB SCSI data phases (3 qTDs)
		and CD/DVD MSC can go larger; 12 covers typical two-device
		(MSC + FT232R or MSC + HUB) workloads.  Raise if concurrent
		USB I/O reports EHCI_TRACE1_QTDALLOC_FAILED.

config T113_EHCI_BUFSIZE
	int "EHCI internal data buffer size"
	depends on T113_EHCI
	default 128

config T113_OHCI
	bool "Enable USB1 OHCI (Full/Low Speed companion)"
	default y

config T113_OHCI_NEDS
	int "Number of OHCI Endpoint Descriptor (ED) structures"
	depends on T113_OHCI
	default 4

config T113_OHCI_NTDS
	int "Number of OHCI Transfer Descriptor (TD) structures"
	depends on T113_OHCI
	default 8

config T113_OHCI_TDBUFFERS
	int "Number of OHCI request/descriptor buffers"
	depends on T113_OHCI
	default 6
	---help---
	  Shared pool of small (TDBUFSIZE) buffers used by
	  DRVR_ALLOC. Each class driver that claims a persistent
	  ctrlreq consumes one slot for the device's lifetime, plus
	  enumeration transiently borrows one more. With hub + FT232R
	  enabled, 2 slots is too tight; 6 leaves headroom for a
	  compound device and concurrent enumeration.

config T113_OHCI_TDBUFSIZE
	int "OHCI request/descriptor buffer size (bytes)"
	depends on T113_OHCI
	default 128

endif # T113_USBHOST

config T113_HWSPINLOCK
	bool "T113 hardware spinlock driver"
	default n
	---help---
	  Enables the T113-S3 32-lock hardware spinlock module at
	  0x03005000. Provides 32 hwspinlock_dev_s instances accessible
	  via the standard NuttX hwspinlock framework.

config T113_AMP
	bool "T113 AMP mode (separate NuttX image per CPU, hwspinlock for shared regs)"
	default n
	depends on !SMP && !BMP
	select T113_HWSPINLOCK
	---help---
	  Enables Asymmetric Multi-Processing where CPU0 and CPU1 each
	  run an independent NuttX image with separate kernel state.
	  Selects T113_HWSPINLOCK so cross-image shared-register access
	  (CCU, etc.) is serialized via the hardware spinlock module.
	  Drivers continue to use the t113_ccu_* helpers; the helpers
	  switch their backing primitive automatically.

	  Mutually exclusive with SMP and BMP: AMP runs two independent
	  NuttX images, each linked to a different DRAM region, while
	  SMP/BMP run a single image across both CPUs.

choice
	prompt "T113 rptun role (this image)"
	optional
	depends on RPTUN && !BMP
	---help---
		Compile-time rptun role for the multi-image splits.  A master image
		(core0-NuttX) ELF-loads one or more remote cores; a slave image is the
		remote core that a master loads.  BMP decides the role at run time by
		this_cpu() and does not select here; single-core images select none.

config T113_RPTUN_SLAVE
	bool "slave (this NuttX image is ELF-loaded by a master)"
	depends on !SMP
	---help---
		This image is the remote NuttX slave that a master (Linux remoteproc
		or core0-NuttX) ELF-loads into the carveout.  It carries a static
		ver=1 .resource_table section, skips master-owned clock/GIC/DMA
		bring-up, and needs a Normal-NC remap of the shared vring window.
		A slave is a single-core image, so it is incompatible with SMP.

endchoice # T113 rptun role

config T113_RPTUN_MASTER
	bool
	---help---
		Derived (no prompt): set automatically by T113_RPTUN_CORE1 and/or
		T113_RPTUN_DSP via select, so MASTER == (CORE1 || DSP) always holds.
		core0-NuttX registers an rptun device per remote core it loads and
		starts each with "rptun start /dev/rptun/<core>".  Coexists with SMP
		(the AP side may be SMP while still mastering a remote core such as
		the DSP).  There is no "bare master" with no target to load.

config T113_RPTUN_CORE1
	bool "master loads the CPU1 NuttX image (core1)"
	default n
	depends on RPTUN_LOADER
	select T113_RPTUN_MASTER
	---help---
		Register /dev/rptun/core1 on core0 so the CPU1 NuttX image can be
		loaded as a standard ELF and started with
		"rptun start /dev/rptun/core1", the same firmware Linux remoteproc
		loads.  The loader resolves the entry from the ELF e_entry; CPU1 is
		released from reset there.

config T113_RPTUN_CORE1_FIRMWARE_PATH
	string "CPU1 NuttX (core1) firmware ELF path"
	default "/fw/core1.elf"
	depends on T113_RPTUN_CORE1
	---help---
		Filesystem path to the CPU1 NuttX firmware ELF that the rptun loader
		opens when core1 is started.  Defaults to /fw/core1.elf, packed into
		the fwromfs image on NAND mtd1 and mounted read-only at /fw.  This is
		the same ELF Linux remoteproc loads from /lib/firmware (byte-identical
		build artifact).

config T113_RPTUN_DSP
	bool "master loads the HiFi4 DSP"
	default n
	depends on RPTUN_LOADER
	select T113_RPTUN_MASTER
	---help---
		Register /dev/rptun/dsp on core0 so the on-chip Cadence HiFi4 DSP
		(aw_axi_cfg0, LX7.1.4) can be loaded as a standard ELF and started
		with "rptun start /dev/rptun/dsp".  Enables the DSP clock/reset
		sequencing (t113_dsp_release / t113_dsp_halt) and the MSGBOX rptun
		doorbell.  On this board the DSP is brought up only through rptun.

config T113_RPTUN_DSP_FIRMWARE_PATH
	string "HiFi4 DSP firmware ELF path"
	default "/fw/dsp.elf"
	depends on T113_RPTUN_DSP
	---help---
		Filesystem path to the HiFi4 DSP firmware ELF that the rptun loader
		opens when the DSP is started.  Defaults to /fw/dsp.elf, packed into
		the fwromfs image on NAND mtd1 and mounted read-only at /fw.

config T113_MSGBOX_IRQ
	int "MSGBOX -> CPUX(ARM) GIC interrupt number"
	default 32
	depends on T113_RPTUN_DSP
	---help---
		NuttX GIC IRQ number for the ARM-side MSGBOX interrupt.  The MSGBOX is
		the DSP rptun doorbell.  GIC ID 32 (SPI 0) is verified on hardware.

config T113_RPTUN_CORE1_CARVEOUT_BASE
	hex "core1 rproc carveout base (vrings + rpmsg buffer pool)"
	default 0x47E00000
	depends on T113_RPTUN_SLAVE || T113_RPTUN_CORE1
	---help---
	  Physical base of the no-map carveout shared between core0 and the CPU1
	  NuttX slave (core1).  The bottom 1 MB section holds vring0, vring1 and
	  the rpmsg buffer pool; the slave image (CONFIG_RAM_START) is linked
	  above it.  Must equal the master's reserved-memory region and the
	  vring/carveout addresses in the static resource_table.

	  The carveout extent (size) is owned by the master's reserved-memory
	  node -- the single source of truth for the DDR split.  NuttX only needs
	  this base plus its own RAM_START/RAM_SIZE; the linker asserts the image
	  stays above the shared window and inside installed DRAM.

	  T113_RPTUN_CORE1 (core0 NuttX as the core1 master) reuses this base:
	  core0 loads the CPU1 ELF into the slave image span above it and shares
	  the vring window, so it maps [base, DDR top) Non-Cacheable.

menuconfig T113_SMHC
