include armv8-m/Make.defs

# arch/arm/src/bk7258
#
CHIP_CSRCS += bk7258_start.c bk7258_vectors.c bk7258_irq.c bk7258_serial.c
CHIP_CSRCS += bk7258_allocateheap.c bk7258_timer.c bk7258_lowputc.c
CHIP_CSRCS += bk7258_syslog.c bk7258_mbox0.c bk7258_mailbox_channel.c
CHIP_CSRCS += bk7258_mb_uart.c bk7258_idle.c bk7258_ipc_heartbeat.c
CHIP_CSRCS += bk7258_pm_pwc.c
ifeq ($(CONFIG_BK7258_PSRAM),y)
CHIP_CSRCS += bk7258_psram.c
endif
ifeq ($(CONFIG_BK7258_AUDIO),y)
CHIP_CSRCS += bk7258_aud.c bk7258_audio_diag.c
endif
ifeq ($(CONFIG_BK7258_PCM),y)
CHIP_CSRCS += bk7258_pcm.c
endif
CHIP_CSRCS += bk7258_wifi_probe.c
ifeq ($(CONFIG_BK7258_WIFI),y)
CHIP_CSRCS += bk7258_wifi.c
endif
ifeq ($(CONFIG_BK7258_CP_TRNG),y)
CHIP_CSRCS += bk7258_random.c
endif
ARCHINCLUDES += ${shell $(INCDIR) $(INCDIROPT) "$(CC)" $(CHIP_DIR)/include}
ARCHINCLUDES += ${shell $(INCDIR) $(INCDIROPT) "$(CC)" $(CHIP_DIR)/hardware}
