include common/Make.defs

ifeq ($(CONFIG_ARCH_CHIP_LS2K0300),y)

CHIP_CSRCS  = ls2k0300_start.c ls2k0300_lowputc.c ls2k0300_irq.c
CHIP_CSRCS += ls2k0300_allocateheap.c ls2k0300_clockconfig.c
CHIP_CSRCS += ls2k0300_serial.c

ifeq ($(CONFIG_LS2K0300_ADC),y)
CHIP_CSRCS += ls2k0300_adc.c
endif

ifeq ($(CONFIG_LS2K0300_RTC),y)
CHIP_CSRCS += ls2k0300_rtc.c
endif

ifeq ($(CONFIG_LS2K0300_I2C),y)
CHIP_CSRCS += ls2k0300_i2c.c
endif

ifeq ($(CONFIG_LS2K0300_PWM),y)
CHIP_CSRCS += ls2k0300_pwm.c
endif

ifeq ($(CONFIG_LS2K0300_SPI),y)
CHIP_CSRCS += ls2k0300_spi.c
endif

ifeq ($(CONFIG_LS2K0300_SPIIO),y)
CHIP_CSRCS += ls2k0300_spiio.c
endif

ifeq ($(CONFIG_TIMER),y)
CHIP_CSRCS += ls2k0300_timerisr.c
endif

CHIP_ASRCS  = ls2k0300_head.S

endif
