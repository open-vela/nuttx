include common/Make.defs

# P4 supplies its scheduler tick from the Espressif system timer.  The
# contest baseline adds the generic MTIME lower half unconditionally, while
# its oneshot ABI is older than that source.  Do not build this unused second
# timer implementation for P4.

CMN_CSRCS := $(filter-out riscv_mtimer.c,$(CMN_CSRCS))

# ESP32-P4 requires the P4-capable HAL. Keep this override local so the
# existing C3/C6/H2 ports retain openvela's validated global HAL revision.
ESP_HAL_3RDPARTY_VERSION = 8d0a898910084206721a0892ab093021bca1496a

include common/espressif/Make.defs

CHIP_CSRCS += esp_chip_rev.c

ifeq ($(CONFIG_ESP32P4_HWLP_CONTEXT),y)
CHIP_CSRCS += esp32p4_extctx.c
endif

ifeq ($(CONFIG_ESP32P4_PIE_PROBE),y)
ifeq ($(wildcard $(VELAFIT_PIE_CC)),)
$(error CONFIG_ESP32P4_PIE_PROBE requires the pinned VELAFIT_PIE_CC compiler)
endif
CHIP_ASRCS += esp32p4_pie_probe.S
esp32p4_pie_probe.o: CC = $(VELAFIT_PIE_CC)
esp32p4_pie_probe.o: AFLAGS += -march=rv32imac_zicsr_xespv -mabi=ilp32
endif

ifeq ($(CONFIG_ESP32P4_PIE_CONTEXT),y)
CHIP_ASRCS += esp32p4_pie_context.S
esp32p4_pie_context.o: CC = $(VELAFIT_PIE_CC)
esp32p4_pie_context.o: AFLAGS += -march=rv32imac_zicsr_xespv -mabi=ilp32
endif

ifeq ($(CONFIG_ESP32P4_MIPI_CSI),y)
CHIP_CSRCS += esp32p4_mipi_csi.c
endif

ifeq ($(CONFIG_ESP32P4_I2S),y)
CHIP_CSRCS += esp32p4_i2s.c
endif

ifeq ($(CONFIG_ESP32P4_MIPI_DSI),y)
CHIP_CSRCS += esp32p4_mipi_dsi.c
endif

ifeq ($(CONFIG_ESP32P4_DMA2D),y)
CHIP_CSRCS += esp32p4_dma2d.c
endif

ifeq ($(CONFIG_ESP32P4_PPA),y)
CHIP_CSRCS += esp32p4_ppa.c
endif

ifeq ($(CONFIG_ESP32P4_SDMMC),y)
CHIP_CSRCS += esp32p4_sdmmc.c
endif

CFLAGS += ${DEFINE_PREFIX}_RETARGETABLE_LOCKING
CFLAGS += ${DEFINE_PREFIX}CONFIG_ESPRESSIF_LOG_LEVEL=0
CFLAGS += -include common/espressif/esp_p4_sched_compat.h

# The HAL OS adapter targets a newer NuttX scheduler API.  Keep its shim
# local to that single dependency source instead of patching the checkout.

chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)nuttx$(DELIM)src$(DELIM)platform$(DELIM)os.c_CFLAGS += -include common/espressif/esp_p4_hal_os_compat.h

# The NuttX P4 image uses the ROM SHA implementation.  Selecting the HAL's
# RAM/non-OS branch also keeps bootloader_sha.c from pulling the ESP-IDF PSA
# headers into builds that enable the independent nuttx-apps Mbed TLS library.
# Both libraries otherwise export an mbedtls/ include tree with incompatible
# configuration headers.

chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)bootloader_support$(DELIM)src$(DELIM)bootloader_sha.c_CFLAGS += -DNON_OS_BUILD=1
