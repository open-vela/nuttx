include common/Make.defs

# P4 supplies its scheduler tick from the Espressif system timer.  The
# contest baseline adds the generic MTIME lower half unconditionally, while
# its oneshot ABI is older than that source.  Do not build this unused second
# timer implementation for P4.

CMN_CSRCS := $(filter-out riscv_mtimer.c,$(CMN_CSRCS))

# ESP32-P4 requires the P4-capable HAL. Keep this override local so the
# existing C3/C6/H2 ports retain openvela's validated global HAL revision.
ESP_HAL_3RDPARTY_VERSION = 8d0a898910084206721a0892ab093021bca1496a

include common/espressif/Make.defs

CHIP_CSRCS += esp_chip_rev.c

ifeq ($(CONFIG_ESP32P4_MIPI_CSI),y)
CHIP_CSRCS += esp32p4_mipi_csi.c
endif

CFLAGS += ${DEFINE_PREFIX}_RETARGETABLE_LOCKING
CFLAGS += ${DEFINE_PREFIX}CONFIG_ESPRESSIF_LOG_LEVEL=0
CFLAGS += -include common/espressif/esp_p4_sched_compat.h

# The HAL OS adapter targets a newer NuttX scheduler API.  Keep its shim
# local to that single dependency source instead of patching the checkout.

chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)nuttx$(DELIM)src$(DELIM)platform$(DELIM)os.c_CFLAGS += -include common/espressif/esp_p4_hal_os_compat.h
