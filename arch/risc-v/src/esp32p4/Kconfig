config ESPRESSIF_SPIRAM_SPEED
	int
	default 20 if ESPRESSIF_SPIRAM_SPEED_20M
	default 80 if ESPRESSIF_SPIRAM_SPEED_80M
	default 200 if ESPRESSIF_SPIRAM_SPEED_200M
	default 250 if ESPRESSIF_SPIRAM_SPEED_250M

config ESPRESSIF_SPIRAM_USER_HEAP
	bool "Add SPIRAM to user heap"
	default y
	select ESPRESSIF_DONT_USE_ROM_LIBC
	---help---
		Add SPIRAM as an additional NuttX heap region.

config ESPRESSIF_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
	bool "Allow .bss segment placed in external memory"
	default n
	---help---
		If enabled, variables with EXT_RAM_BSS_ATTR attribute will be
		placed in SPIRAM instead of internal DRAM.

		BSS sections from esp-hal-3rdparty components can also be placed
		in SPIRAM through linker fragment mappings when enabled.

		Note that variables placed in SPIRAM this way are still
		zero-initialized at startup.

endif # ESPRESSIF_SPIRAM

# Aggregate I2C controller mode gates consumed by the driver layer
# (espressif/Make.defs and the board glue).  The P4 port currently
# supports master mode only; the controllers themselves (ESPRESSIF_I2C0/1)
# are defined in the sourced common Kconfig.

config ESPRESSIF_I2C0_MASTER_MODE
	bool
	default y if ESPRESSIF_I2C0

config ESPRESSIF_I2C1_MASTER_MODE
	bool
	default y if ESPRESSIF_I2C1

config ESPRESSIF_I2C_PERIPH_MASTER_MODE
	bool
	default y if ESPRESSIF_I2C0_MASTER_MODE || ESPRESSIF_I2C1_MASTER_MODE

config ESPRESSIF_I2C_PERIPH_SLAVE_MODE
	bool
	default n

config ESPRESSIF_MIPI_DSI
	bool "MIPI DSI display support"
	default n
	select FB_UPDATE if VIDEO_FB
	---help---
		Enable the MIPI DSI host/bridge driver used to drive DSI panels
		in DPI video mode, continuously streaming an RGB565 framebuffer
		through a dedicated DW-GDMA channel.

config ESPRESSIF_MIPI_CSI
	bool "MIPI CSI camera support"
	default n
	select DRIVERS_VIDEO
	---help---
		Enable the MIPI CSI-2 camera capture driver.  The pipeline is
		CSI D-PHY -> DWC CSI-2 host -> ISP (inline RAW8 Bayer to
		RGB565 conversion) -> CSI bridge -> DW-GDMA into a frame
		buffer in memory.  The driver is exposed as a NuttX imgdata
		lower half for the video capture (V4L2) framework and is
		paired with an image sensor driver by the board logic.

config ESPRESSIF_MIPI_CSI_RAW_PASSTHROUGH
	bool "MIPI CSI RAW passthrough (bypass ISP conversion)"
	depends on ESPRESSIF_MIPI_CSI
	default n
	---help---
		Debug aid: keep the ISP in bypass mode so the captured buffer
		contains the RAW8 Bayer data exactly as received from the
		sensor instead of ISP-demosaiced RGB565.  The format is
		still advertised as RGB565 to the framework, but a RAW8
		frame is half the size and the driver reports the real byte
		count, so the rendered image will look wrong.  Use only to
		verify the CSI link and DMA path independently of the ISP
		programming.

menu "SD/MMC Configuration"

config ESP32P4_SDMMC
	bool "SD/MMC (SDIO host) driver"
	default n
	select ARCH_HAVE_SDIO
	select SDIO_BLOCKSETUP
	select MMCSD
	select MMCSD_SDIO
	select SCHED_WORKQUEUE
	select SCHED_HPWORK
	select ESP32P4_SDMMC_DMA
	---help---
		Enable the ESP32-P4 SDMMC host (Synopsys DesignWare IP),
		exposing a NuttX struct sdio_dev_s.  Stage 1 of the esp-hosted
		bring-up uses it to enumerate the on-board ESP32-C6 as an SDIO
		card.

		NOTE: the SDIO pin numbers below (ESP32P4_SDMMC_*) overlap the
		ESPRESSIF_ESP_HOSTED_SDIO_* symbols.  The arch driver reads the
		ESP32P4_SDMMC_* symbols; the ESP_HOSTED pin symbols should be
		reconciled to select ESP32P4_SDMMC and drop the duplicates.

if ESP32P4_SDMMC

config ESP32P4_SDMMC_DMA
	bool "Support DMA for SD/MMC"
	default y
	select SDIO_DMA
	---help---
		Use the SDMMC internal DMA (IDMAC) for data transfers.

config ESP32P4_SDMMC_SLOT
	int "SDMMC slot"
	default 1
	range 0 1
	---help---
		SDMMC slot.  The on-board ESP32-C6 is wired to slot 1 and is
		routed through the GPIO matrix.

config ESP32P4_SDMMC_WIDTH
	int "SDIO bus width"
	default 4
	---help---
		SDIO data bus width to ramp to after ID mode (1 or 4).

config ESP32P4_SDMMC_FREQ
	int "SDIO clock frequency (kHz)"
	default 40000
	---help---
		Target card clock frequency after ID mode.

config ESP32P4_SDMMC_CLK
	int "CLK GPIO"
	default 18

config ESP32P4_SDMMC_CMD
	int "CMD GPIO"
	default 19

config ESP32P4_SDMMC_D0
	int "D0 GPIO"
	default 14

config ESP32P4_SDMMC_D1
	int "D1 GPIO"
	default 15

config ESP32P4_SDMMC_D2
	int "D2 GPIO"
	default 16

config ESP32P4_SDMMC_D3
	int "D3 GPIO"
	default 17

endif # ESP32P4_SDMMC

endmenu # SD/MMC Configuration

menuconfig ESPRESSIF_ESP_HOSTED
	bool "Wi-Fi via ESP32-C6 co-processor (esp-hosted over SDIO)"
	default n
	---help---
		Use the on-board ESP32-C6 as a Wi-Fi co-processor through the
		Espressif esp-hosted architecture: the ESP32-P4 host drives the
		C6 over a 4-bit SDIO link and forwards Wi-Fi operations to it as
		RPC commands.  The co-processor ships pre-flashed with the
		esp-hosted slave firmware.

if ESPRESSIF_ESP_HOSTED

