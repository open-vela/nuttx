diff --git a/components/esp_hw_support/esp_gpio_reserve.c b/components/esp_hw_support/esp_gpio_reserve.c
index c2e5ec71c08..5794608287d 100644
--- a/components/esp_hw_support/esp_gpio_reserve.c
+++ b/components/esp_hw_support/esp_gpio_reserve.c
@@ -4,27 +4,47 @@
  * SPDX-License-Identifier: Apache-2.0
  */
 
-#include <stdatomic.h>
+/* openvela: rv32 has no native 64-bit atomics and the toolchain builtins
+ * (__atomic_fetch_or_8 etc.) are not provided by the OS libc, so guard the
+ * reservation mask with a critical section instead of C11 atomics.
+ */
+
+
+#include <nuttx/spinlock.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <nuttx/irq.h>
 #include "soc/soc_caps.h"
 #include "esp_types.h"
 #include "esp_bit_defs.h"
 #include "esp_private/esp_gpio_reserve.h"
 
-static _Atomic uint64_t s_reserved_pin_mask = ATOMIC_VAR_INIT(~(SOC_GPIO_VALID_GPIO_MASK));
+static uint64_t s_reserved_pin_mask = ~(SOC_GPIO_VALID_GPIO_MASK);
 
 uint64_t esp_gpio_reserve(uint64_t gpio_mask)
 {
-    return atomic_fetch_or(&s_reserved_pin_mask, gpio_mask);
+    irqstate_t flags = enter_critical_section();
+    uint64_t prev = s_reserved_pin_mask;
+    s_reserved_pin_mask |= gpio_mask;
+    leave_critical_section(flags);
+    return prev;
 }
 
 uint64_t esp_gpio_revoke(uint64_t gpio_mask)
 {
-    return atomic_fetch_and(&s_reserved_pin_mask, ~gpio_mask);
+    irqstate_t flags = enter_critical_section();
+    uint64_t prev = s_reserved_pin_mask;
+    s_reserved_pin_mask &= ~gpio_mask;
+    leave_critical_section(flags);
+    return prev;
 }
 
 bool esp_gpio_is_reserved(uint64_t gpio_mask)
 {
-    return atomic_load(&s_reserved_pin_mask) & gpio_mask;
+    irqstate_t flags = enter_critical_section();
+    bool reserved = (s_reserved_pin_mask & gpio_mask) != 0;
+    leave_critical_section(flags);
+    return reserved;
 }
 
