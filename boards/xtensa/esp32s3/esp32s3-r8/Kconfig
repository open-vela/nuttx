#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_ESP32S3_R8

config ESP32S3_R8_LCD
	bool "Enable ESP32-S3-R8 LCD"
	default n
	select ESP32S3_SPI2
	select SPI_CMDDATA
	select LCD
	select LCD_DEV
	select LCD_ST7789
	---help---
		Enable the ESP32-S3-R8 ST7789V LCD.

endif # ARCH_BOARD_ESP32S3_R8
