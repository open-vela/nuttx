# ESP32-P4 Function-EV cumulative L2.5 configuration plus board-mounted SPI
# Flash MTD and SmartFS.
#
# This configuration carries forward the verified L2.5 baseline and adds the
# board-mounted SPI Flash storage path. The storage range follows the existing
# same-board reference configuration and is kept below the 16 MiB flash end.

CONFIG_ARCH="risc-v"
CONFIG_ARCH_FAMILY="risc-v"
CONFIG_ARCH_BOARD="esp32p4-function-ev-board"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32P4_FUNCTION_EV_BOARD=y
CONFIG_ARCH_CHIP="esp32p4"
CONFIG_ARCH_CHIP_ESP32P4=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_IRQ_TO_NDX=y
CONFIG_ARCH_MINIMAL_VECTORTABLE_DYNAMIC=y
