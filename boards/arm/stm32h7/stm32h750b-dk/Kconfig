#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_STM32H750B_DK

config STM32H750B_DK_BUTTONS
	bool "Board button support (USER1 on PC13)"
	default n
	select ARCH_HAVE_BUTTONS
	select ARCH_HAVE_IRQBUTTONS
	---help---
		Support the B1 USER pushbutton on PC13.  Builds the board button
		interface (board_button_initialize, board_buttons and
		board_button_irq), and permits ARCH_BUTTONS, ARCH_IRQBUTTONS,
		INPUT_BUTTONS and INPUT_BUTTONS_LOWER, which together register
		the button driver as /dev/buttons.

		The pin is an input with a pull-down and reads high while the
		button is depressed (ST BSP v3.3.4 and on-board measurement).

config STM32H750B_DK_QSPI_BOOT
	bool "Link Cortex-M7 image for external QSPI boot"
	default n
	depends on ARCH_CHIP_STM32H7_CORTEXM7
	---help---
		Build the main NuttX image for the STM32H750B-DK external
		dual-QSPI memory-mapped window at 0x90000000 instead of the
		128 KiB on-die Flash at 0x08000000. This image needs a small
		internal-Flash boot stub that initializes QSPI memory-mapped
		mode before jumping to the external vector table.

endif # ARCH_BOARD_STM32H750B_DK
