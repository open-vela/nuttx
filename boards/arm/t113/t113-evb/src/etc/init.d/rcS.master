#include <nuttx/config.h>

#ifdef CONFIG_T113_AMP
echo "\n\rT113 NuttX AMP master (core0) ready"
#else
echo "\n\rT113 NuttX SMP master ready"
#endif

/* Start each remote the master is configured to load. */

#ifdef CONFIG_T113_RPTUN_CORE1
rptun start /dev/rptun/core1
#endif

#ifdef CONFIG_T113_RPTUN_DSP
rptun start /dev/rptun/dsp
#endif
