#include <nuttx/config.h>

set +e

/* Per-image rcS dispatcher.  Four explicit cases:
 *   T113_BOOT0          -> rcS.bl      (boot0 SPL)
 *   RPTUN_MASTER        -> rcS.master  (loads remotes per CORE1/DSP)
 *   RPTUN_SLAVE         -> rcS.slave   (AMP / Linux slave)
 *   default             -> rcS.ap      (single-image AP / SMP)
 *
 * A new build mode added without a matching Kconfig switch falls
 * through to rcS.ap silently -- that is intentional, not a bug, since
 * non-master / non-boot0 configs are by definition the plain AP.
 */

#ifdef CONFIG_T113_BOOT0
#include "rcS.bl"
#elif defined(CONFIG_T113_RPTUN_MASTER)
#include "rcS.master"
#elif defined(CONFIG_T113_RPTUN_SLAVE)
#include "rcS.slave"
#else
#include "rcS.ap"
#endif

#ifdef CONFIG_FS_YAFFS
mount -t yaffs -o autoformat /dev/mtd2 /mnt
#endif
