#
# openvela xTS core test image for FRDM-MCXN947.
#
# This configuration enables the core no-extra-hardware xTS applications.
#

CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="frdm-mcxn947"
CONFIG_ARCH_BOARD_FRDM_MCXN947=y
CONFIG_ARCH_CHIP="mcx-nxxx"
CONFIG_ARCH_CHIP_MCX_NXXX=y
CONFIG_ARCH_CHIP_N947=y
# CONFIG_ARCH_LEDS is not set
CONFIG_ARCH_INTERRUPTSTACK=4096
CONFIG_ARCH_STACKDUMP=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_LOOPSPERMSEC=2664
CONFIG_BUILTIN=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEFAULT_TASK_STACKSIZE=8192
CONFIG_FS_PROCFS=y
CONFIG_FS_TMPFS=y
CONFIG_IDLETHREAD_STACKSIZE=4096
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INPUT=y
CONFIG_INTELHEX_BINARY=y
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIBC_LOCALTIME=y
CONFIG_LIBC_LONG_LONG=y
CONFIG_LIBC_SCANSET=y
CONFIG_LPUART4_SERIAL_CONSOLE=y
CONFIG_MM_REGIONS=2
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NXXX_LPUART4=y
CONFIG_PIPES=y
CONFIG_RAM_SIZE=425984
CONFIG_RAM_START=0x20000000
CONFIG_RAW_BINARY=y
CONFIG_SCHED_BACKTRACE=y
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_LPWORK=y
CONFIG_SERIAL_TERMIOS=y
CONFIG_STACK_COLORATION=y
CONFIG_START_DAY=14
CONFIG_START_MONTH=3
CONFIG_SYSLOG_CONSOLE=y
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_POPEN=y
CONFIG_SYSTEM_SYSTEM=y

# xTS 1.1 simple kernel/libc applications

CONFIG_EXAMPLES_HELLO=y
CONFIG_EXAMPLES_PIPE=y
CONFIG_EXAMPLES_POPEN=y
CONFIG_TESTING_GETPRIME=y
CONFIG_TESTING_MM=y
CONFIG_TESTING_OSTEST=y
CONFIG_TESTING_SCANFTEST=y

# xTS 1.3 RAM and filesystem applications

CONFIG_TESTING_FSTEST=y
CONFIG_TESTING_FSTEST_NLOOPS=10
CONFIG_TESTING_RAMTEST=y
