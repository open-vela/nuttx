# rc.sysinit - openvela H616 system init (NSH executes line by line)
# '#' lines are ignored by NSH. This file goes into romfs verbatim.

set +e
set TZ Asia/Shanghai

# /proc is mounted by the board bringup and /etc by NSH itself; only the
# pseudo file systems the kernel does not provide are mounted here.
mount -t tmpfs none /tmp
mount -t binfs none /bin

# Mount the eMMC vfat partition registered by the board bringup.  The volume
# spans the whole eMMC above the raw boot regions; on the very first boot
# (or after a partition layout change) it has no file system yet, so format
# it once and retry the mount.
mkdir /mnt
mount -t vfat /dev/mmcsd0p1 /mnt
if [ $? -ne 0 ]
then
  mkfatfs -F 32 /dev/mmcsd0p1
  mount -t vfat /dev/mmcsd0p1 /mnt
fi

# Self check: listing the volume is what tells a working bus from a
# silently broken one.
ls /mnt
